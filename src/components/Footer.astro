---
import Logo from './Logo.astro';
import { site } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="bg-navy-900 text-sand-300">
  <div class="container-site flex flex-col gap-6 py-10 text-sm sm:flex-row sm:items-center sm:justify-between">
    <Logo />
    <p class="flex flex-wrap items-center gap-x-2">
      <span>{site.ownerTitle} {site.owner}</span>
      <span aria-hidden="true">·</span>
      <a href={`mailto:${site.email}`} class="inline-block py-2 [overflow-wrap:anywhere] hover:text-ice-300">{site.email}</a>
    </p>
  </div>
  <div class="border-t border-white/10">
    <p class="container-site py-5 text-xs">&copy; {year} {site.name}</p>
  </div>
</footer>
