---
import Logo from './Logo.astro';
import { site } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="bg-navy-900 text-sand-300">
  <div class="container-site flex flex-col gap-6 py-10 text-sm sm:flex-row sm:flex-wrap sm:items-center sm:justify-between">
    <Logo class="shrink-0" />
    <p class="flex flex-wrap items-center gap-x-2">
      <span>{site.ownerTitle} {site.owner}</span>
      <span aria-hidden="true">·</span>
      <a href={`mailto:${site.email}`} class="inline-block py-2 [overflow-wrap:anywhere] hover:text-ice-300">{site.email}</a>
    </p>
  </div>
  <div class="border-t border-white/10">
    <div class="container-site flex flex-col gap-1 py-5 text-xs sm:flex-row sm:flex-wrap sm:gap-x-6">
      <p>&copy; {year} {site.name}</p>
      <p>CVR-nr. {site.cvr}</p>
      <p>Autorisations-ID {site.autorisationsId}</p>
    </div>
  </div>
</footer>
