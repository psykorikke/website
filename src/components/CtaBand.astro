---
import { site } from '../config/site';
import Splash from './Splash.astro';
---

<!-- No backend: contact happens via e-mail only. -->
<section id="kontakt" class="relative scroll-mt-20 overflow-hidden bg-ice-300 py-14 md:py-20">
  <Splash class="-right-16 -top-24 h-72 w-72 text-white opacity-20" flip rotate={-35} />
  <div class="container-site relative grid items-center gap-8 md:grid-cols-[2fr_1fr]">
    <div>
      <h2 class="text-2xl sm:text-3xl">Book et oplæg eller en workshop</h2>
      <p class="mt-3 max-w-2xl text-navy-800">Skriv et par ord om jeres arbejdsplads, så vender jeg tilbage.</p>
    </div>
    <div class="md:text-right">
      <a href={`mailto:${site.email}`} class="btn bg-navy-900 text-white hover:bg-navy-700">Send en e-mail</a>
      <p class="mt-3 text-sm text-navy-800">
        <a href={`mailto:${site.email}`} class="inline-block py-2 [overflow-wrap:anywhere] underline underline-offset-4 hover:text-navy-900">{site.email}</a>
      </p>
    </div>
  </div>
</section>
