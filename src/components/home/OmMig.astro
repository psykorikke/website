---
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
// Cover of Rikke's master's thesis (her own document; cropped so the student number is not shown).
import specialeForside from '../../assets/images/om-mig/speciale-forside.jpg';
import { site } from '../../config/site';
import { erfaring, specialer } from '../../data/content';
---

<section id="om-mig" class="scroll-mt-20 bg-white py-16 md:py-24" aria-labelledby="om-mig-titel">
  <div class="container-site grid gap-10 md:grid-cols-2 md:gap-16">
    <div>
      <h2 id="om-mig-titel" class="text-2xl sm:text-3xl">Om mig</h2>
      <p class="mt-5 text-base sm:text-lg">
        Jeg hedder {site.owner} og er {site.ownerTitle.toLowerCase()}. Mine oplæg og workshops handler om mennesket på arbejdspladsen – og de tre områder, jeg arbejder med, kender jeg indefra.
      </p>
      <p class="mt-4 text-base sm:text-lg">
        Jeg har indgående kendskab til krydspres og dobbeltbelastninger og en stor interesse for samspilsdynamikker og sociale spilleregler.
      </p>
      <p class="mt-4 text-base sm:text-lg">
        Jeg har udarbejdet specialeafhandlingen "Fra Kollega til Leder" i samarbejde med Beredskabsstyrelsen. Projektet er et casestudie, som følger nyuddannede holdledere i deres første tid i forskellige beredskaber i Danmark. Her undersøges krydsbelastningen ved de mange rolleskift og de særlige vilkår og udfordringer, som den nyuddannede holdleder skal forholde sig til.
      </p>
    </div>

    <div class="min-w-0 space-y-4">
      <ul class="space-y-4">
        {erfaring.map((item, i) => (
          <li class="flex items-center gap-4 bg-sand-50 p-5 ring-1 ring-sand-200">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-navy-900 text-ice-300">
              <Icon path={specialer[i].icon} class="h-5 w-5" />
            </span>
            <span class="text-navy-900">{item}</span>
          </li>
        ))}
      </ul>

      <figure class="flex flex-col items-start gap-4 bg-navy-900 p-5 min-[420px]:flex-row min-[420px]:items-center sm:gap-6">
        <Image
          src={specialeForside}
          alt="Forsiden af specialeafhandlingen Fra kollega til leder: en brandmand ved en brandbil, spejlet i en vandpyt"
          widths={[120, 180, 240, 320]}
          sizes="(min-width: 640px) 128px, 96px"
          class="w-28 shrink-0 shadow-lg min-[420px]:w-24 ring-1 ring-white/10 sm:w-32"
        />
        <figcaption class="min-w-0 hyphens-auto break-words">
          <span class="block text-xs font-semibold uppercase tracking-[0.15em] text-ice-300 sm:tracking-[0.2em]">Specialeafhandling</span>
          <span class="mt-2 block font-serif text-xl font-semibold text-white sm:text-2xl">Fra kollega til leder</span>
          <span class="mt-2 block text-sm text-sand-200">Et organisationspsykologisk perspektiv på holdlederrollen. Aalborg Universitet, 2025.</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>
