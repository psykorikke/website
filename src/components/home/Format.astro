---
import SectionHeading from '../SectionHeading.astro';
import { url } from '../../config/site';
import { formater } from '../../data/content';
---

<section class="bg-white py-20 md:py-28">
  <div class="container-site">
    <SectionHeading eyebrow="Format" title="Oplæg og workshops" />
    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {formater.map((f, i) => (
        <article class={`p-8 sm:p-10 ${i === 0 ? 'bg-ice-100' : 'bg-sand-100'}`}>
          <h3 class="text-xl">{f.title}</h3>
          <p class="mt-4">{f.text}</p>
        </article>
      ))}
    </div>
    <div class="mt-12 text-center">
      <a href={url('/oplaeg')} class="link-underline">Sådan foregår det</a>
    </div>
  </div>
</section>
