---
// Static form placeholder. Connect `action` to a newsletter provider before launch;
// the site is static, so the form must post to an external service.
---

<section class="bg-sand-400 py-16 md:py-20">
  <div class="container-site grid items-center gap-8 md:grid-cols-2">
    <div>
      <h2 class="text-2xl text-white sm:text-3xl">Få ny viden direkte i indbakken</h2>
      <p class="mt-3 text-white/90">Tilmeld dig nyhedsbrevet og få artikler, øvelser og nyheder om nye forløb.</p>
    </div>
    <form class="flex w-full flex-col gap-3 sm:flex-row" action="#" method="post">
      <label for="nyhedsbrev-email" class="sr-only">E-mailadresse</label>
      <input
        id="nyhedsbrev-email"
        type="email"
        name="email"
        required
        placeholder="Din e-mailadresse"
        class="min-w-0 flex-1 bg-white px-5 py-3 text-sm text-ink-900 placeholder:text-ink-500 focus:outline-2 focus:outline-ink-900"
      />
      <button type="submit" class="btn bg-ink-900 text-white hover:bg-ink-700">Tilmeld</button>
    </form>
  </div>
</section>
