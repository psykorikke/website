---
// Placeholder testimonial – replace with a real quote (with permission) before launch.
const quote = {
  text: 'Forløbet gav mig en helt ny forståelse af, hvorfor jeg reagerer, som jeg gør – og konkrete redskaber til at gøre noget ved det.',
  name: 'Navn Efternavn',
  role: 'Deltager i online-forløb',
};
---

<section class="bg-cream-200 py-20 md:py-28">
  <figure class="container-site max-w-3xl text-center">
    <svg class="mx-auto h-10 w-10 text-sand-400" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
      <path d="M9 7C5 9 3 13 3 18v7h9v-9H7c0-3 2-6 5-7zm16 0c-4 2-6 6-6 11v7h9v-9h-5c0-3 2-6 5-7z" />
    </svg>
    <blockquote class="mt-8 text-lg leading-relaxed text-ink-700 sm:text-xl">
      “{quote.text}”
    </blockquote>
    <figcaption class="mt-8">
      <p class="font-semibold text-ink-900">{quote.name}</p>
      <p class="eyebrow mt-1">{quote.role}</p>
    </figcaption>
  </figure>
</section>
