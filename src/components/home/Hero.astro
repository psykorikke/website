---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';
import Icon from '../Icon.astro';
import { site } from '../../config/site';
import { laeringsrum } from '../../data/content';
---

<!-- Navy hero: the logo's own background is navy-900, so it blends into the section. -->
<section class="bg-navy-900">
  <div class="container-site grid items-center gap-10 py-14 md:grid-cols-[3fr_2fr] md:py-20">
    <div class="max-w-2xl">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-ice-300">
        {site.ownerTitle} {site.owner}
      </p>
      <h1 class="text-2xl uppercase leading-snug tracking-[0.04em] break-words hyphens-auto text-white sm:text-3xl sm:tracking-[0.08em] lg:text-4xl">
        Psykologi med blik for særlige belastninger i <span class="text-ice-300">mentale højrisikoerhverv</span>
      </h1>
      <p class="mt-6 text-base text-sand-200 sm:text-lg">
        Oplæg og workshops for kollega- og ledergrupper om mennesket på arbejdspladsen. Gennem et vidensrum, et praksisrum og et refleksionsrum bliver I klogere på jeres samspil – og står stærkere sammen.
      </p>
    </div>

    <div class="mx-auto w-full max-w-[18rem] md:max-w-sm">
      <Image
        src={logo}
        alt={`${site.name}s logo: en hjerne med en blå og en sandfarvet halvdel`}
        widths={[320, 480, 672]}
        sizes="(min-width: 768px) 24rem, 18rem"
        loading="eager"
        fetchpriority="high"
        class="h-auto w-full"
      />
    </div>

    <ul class="grid gap-4 md:col-span-2 md:grid-cols-3" aria-label="Workshoppens tre læringsrum">
      {laeringsrum.map((r) => (
        <li class="flex gap-4 bg-navy-800 p-5 hyphens-auto break-words md:flex-col md:gap-3 lg:flex-row lg:gap-4">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-navy-900 text-ice-300">
            <Icon path={r.icon} class="h-5 w-5" />
          </span>
          <span>
            <span class="block font-semibold text-white">{r.title}</span>
            <span class="mt-1 block text-sm text-sand-200">{r.text}</span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
