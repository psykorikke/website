---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';
import { site } from '../../config/site';
---

<!-- Navy hero: the logo's own background is navy-900, so it blends into the section. -->
<section class="bg-navy-900">
  <div class="container-site grid items-center gap-10 py-14 md:grid-cols-[3fr_2fr] md:py-20">
    <div class="max-w-2xl">
      <p class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-ice-300">
        {site.ownerTitle} {site.owner}
      </p>
      <h1 class="text-3xl uppercase leading-snug tracking-[0.06em] break-words text-white sm:text-4xl sm:tracking-[0.1em] lg:text-5xl">
        Psykologi for fællesskaber <span class="text-ice-300">under pres</span>
      </h1>
      <p class="mt-6 text-base text-sand-200 sm:text-lg">
        Oplæg og workshops for kollega- og ledergrupper om territorier, hierarkier, magtkampe og motivation.
      </p>
    </div>

    <div class="mx-auto w-full max-w-[18rem] md:max-w-sm">
      <Image
        src={logo}
        alt={`${site.name}s logo: en hjerne med en blå og en sandfarvet halvdel`}
        widths={[320, 480, 672]}
        sizes="(min-width: 768px) 24rem, 18rem"
        loading="eager"
        fetchpriority="high"
        class="h-auto w-full"
      />
    </div>
  </div>
</section>
