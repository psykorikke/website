---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.png';
import { site, url } from '../../config/site';
---

<!-- Navy hero: the logo's own background is navy-900, so it blends into the section. -->
<section class="relative overflow-hidden bg-navy-900">
  <div class="container-site grid items-center gap-12 py-16 md:grid-cols-2 md:py-24">
    <div class="relative z-10 max-w-xl">
      <p class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-ice-300">Velkommen til {site.name}</p>
      <h1 class="text-3xl uppercase leading-snug tracking-[0.08em] break-words text-white sm:text-4xl sm:tracking-[0.12em] lg:text-5xl">
        Et bedre liv begynder i <span class="text-ice-300">hjernen</span>
      </h1>
      <p class="mt-6 text-base text-sand-200 sm:text-lg">
        Her finder du viden, værktøjer og forløb, der hjælper dig med at forstå dig selv – og skabe varige forandringer i hverdagen.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-6">
        <a href={url(site.cta.href)} class="btn-primary">{site.cta.label}</a>
        <a href={url('/om')} class="inline-block pt-3 pb-1 text-xs font-semibold uppercase tracking-[0.2em] text-sand-100 border-b-2 border-sand-400 transition-colors hover:text-ice-300 hover:border-ice-300">Læs mere</a>
      </div>
    </div>

    <div class="mx-auto w-full max-w-md">
      <Image
        src={logo}
        alt={`${site.name}s logo: en hjerne med en blå og en sandfarvet halvdel`}
        widths={[360, 560, 840]}
        sizes="(min-width: 768px) 28rem, 90vw"
        loading="eager"
        fetchpriority="high"
        class="h-auto w-full"
      />
    </div>
  </div>
</section>
