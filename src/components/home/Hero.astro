---
import { site, url } from '../../config/site';
---

<section class="relative overflow-hidden bg-cream-200">
  <div class="container-site grid items-center gap-12 py-20 md:grid-cols-2 md:py-28">
    <div class="relative z-10 max-w-xl">
      <p class="eyebrow mb-5">Velkommen til {site.name}</p>
      <h1 class="text-3xl uppercase leading-snug tracking-[0.12em] sm:text-4xl lg:text-5xl">
        Et bedre liv begynder i hjernen
      </h1>
      <p class="mt-6 text-base sm:text-lg">
        Her finder du viden, værktøjer og forløb, der hjælper dig med at forstå dig selv – og skabe varige forandringer i hverdagen.
      </p>
      <div class="mt-10 flex flex-wrap items-center gap-6">
        <a href={url(site.cta.href)} class="btn-primary">{site.cta.label}</a>
        <a href={url('/om')} class="link-underline">Læs mere</a>
      </div>
    </div>

    <!-- Decorative circle with illustration. Replace the SVG with a portrait in public/images when available. -->
    <div class="relative mx-auto aspect-square w-full max-w-md">
      <div class="absolute inset-0 rounded-full bg-sand-400"></div>
      <div class="absolute -left-6 bottom-8 h-24 w-24 rounded-full bg-rose-300/70"></div>
      <div class="absolute -right-2 top-6 h-14 w-14 rounded-full bg-mist-200"></div>
      <svg class="absolute inset-[18%] text-white" viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M100 30c-14-12-40-8-46 10-16 0-28 16-22 32-12 8-12 28 2 36-4 18 12 32 28 28 6 14 26 18 38 8z" />
        <path d="M100 30c14-12 40-8 46 10 16 0 28 16 22 32 12 8 12 28-2 36 4 18-12 32-28 28-6 14-26 18-38 8z" />
        <path d="M100 30v114M70 62c10 2 16 10 16 20M130 62c-10 2-16 10-16 20M58 104c12-4 24 2 28 12M142 104c-12-4-24 2-28 12" />
        <circle cx="100" cy="170" r="6" />
      </svg>
    </div>
  </div>
</section>
