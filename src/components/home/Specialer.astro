---
import Icon from '../Icon.astro';
import { specialer } from '../../data/content';
---

<section class="bg-sand-50 py-16 md:py-24" aria-labelledby="specialer-titel">
  <div class="container-site">
    <h2 id="specialer-titel" class="text-center text-2xl sm:text-3xl">Specialiseret i tre områder</h2>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {specialer.map((s) => (
        <article class="bg-white p-7 shadow-sm ring-1 ring-sand-200 md:p-6 lg:p-8">
          <div class="flex h-14 w-14 items-center justify-center rounded-full bg-navy-900 text-ice-300">
            <Icon path={s.icon} class="h-7 w-7" />
          </div>
          <h3 class="mt-6 text-xl break-words hyphens-auto md:text-lg lg:text-xl">{s.title}</h3>
          <p class="mt-3">{s.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
