---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../Icon.astro';
import { site } from '../../config/site';
import { laeringsrum, specialer } from '../../data/content';

// Photos are picked up automatically from src/assets/images/specialer/<slug>.(jpg|png|webp).
// Until a photo exists, the card shows a tinted panel with the icon instead.
const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/specialer/*.{jpg,jpeg,png,webp}', { eager: true });
const photoFor = (slug: string) =>
  Object.entries(photos).find(([path]) => path.split('/').pop()?.replace(/\.[^.]+$/, '') === slug)?.[1].default;

const tones = ['bg-ice-200', 'bg-sand-200', 'bg-ice-100'];
// Photos: beredskab – provided by Rikke; botilbud – Nathan Anderson, frivillige – Emilio Geremia (Unsplash licence).
// The two Unsplash photos are colour-graded to match the fire service photo (navy shadows, warm highlights).
const alts: Record<string, string> = {
  beredskab: 'Røgdykkere i fuld udrustning foran en kraftig brand',
  botilbud: 'En ældre mand og en ung mand med Downs syndrom griner sammen',
  frivillige: 'En frivillig træner samler et drengehold i fodboldklubben inden kamp',
};
// Crop focus per photo (CSS object-position) – the fire service photo is portrait, so show the lower part.
const focus: Record<string, string> = {
  beredskab: 'center 68%',
};
---

<section id="workshop" class="scroll-mt-18 bg-sand-50 py-16 md:py-24" aria-labelledby="specialer-titel">
  <div class="container-site">
    <h2 id="specialer-titel" class="text-center text-2xl sm:text-3xl">Specialiseret i tre områder</h2>

    <div class="mt-12 grid gap-6 sm:grid-cols-3 sm:gap-4 lg:gap-6">
      {specialer.map((s, i) => {
        const photo = photoFor(s.slug);
        return (
          <article class="flex flex-col overflow-hidden bg-white shadow-sm ring-1 ring-sand-200">
            <div class="relative aspect-[4/3]">
              {photo ? (
                <Image
                  src={photo}
                  alt={alts[s.slug] ?? s.title}
                  sizes="(min-width: 1152px) 360px, (min-width: 640px) 33vw, 100vw"
                  class="absolute inset-0 h-full w-full object-cover"
                  style={focus[s.slug] ? `object-position:${focus[s.slug]}` : undefined}
                />
              ) : (
                <div class={`flex h-full w-full items-center justify-center ${tones[i % tones.length]}`}>
                  <Icon path={s.icon} class="h-16 w-16 text-navy-900/30" />
                </div>
              )}
              <div class="absolute -bottom-6 left-6 flex h-12 w-12 items-center justify-center rounded-full bg-navy-900 text-ice-300 ring-4 ring-white sm:left-4 lg:left-6">
                <Icon path={s.icon} class="h-6 w-6" />
              </div>
            </div>
            <div class="flex flex-1 flex-col p-6 pt-10 sm:p-4 sm:pt-9 lg:p-6 lg:pt-10">
              <h3 class="text-xl break-words hyphens-auto sm:text-base lg:text-xl">{s.title}</h3>
              <p class="mt-3 sm:text-[15px] lg:text-base">{s.text}</p>
            </div>
          </article>
        );
      })}
    </div>

    <!-- The workshop's three learning spaces, shown after the specialisations. -->
    <div class="mt-14 md:mt-16">
      <p class="eyebrow text-center">Workshoppens tre læringsrum</p>
      <ul class="mt-6 grid gap-4 md:grid-cols-3" aria-label="Workshoppens tre læringsrum">
        {laeringsrum.map((r) => (
          <li class="flex gap-4 bg-white p-5 shadow-sm ring-1 ring-ice-200 hyphens-auto break-words md:flex-col md:gap-3 lg:flex-row lg:gap-4">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-navy-900 text-ice-300">
              <Icon path={r.icon} class="h-5 w-5" />
            </span>
            <span>
              <span class="block font-semibold text-navy-900">{r.title}</span>
              <span class="mt-1 block text-sm text-navy-600">{r.text}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>

    {site.samarbejdspartnere.length > 0 && (
      <div id="samarbejdspartnere" class="mt-10 scroll-mt-24 bg-navy-900 px-6 py-7 text-center">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ice-300">Tidligere samarbejdspartnere</p>
        <!-- Each partner is separated by an ice-blue line (vertical on md+, short horizontal on phones).
             A part after ", " (e.g. "Center for Uddannelse") is shown as a small subtitle. -->
        <ul class="mt-5 flex flex-col items-center justify-center md:flex-row md:items-stretch">
          {site.samarbejdspartnere.map((navn, i) => {
            const [hoved, ...rest] = navn.split(', ');
            const under = rest.join(', ');
            return (
              <li class="flex flex-col items-center md:flex-row">
                {i > 0 && <span class="my-4 h-0.5 w-12 bg-ice-300 md:mx-10 md:my-0 md:h-auto md:w-0.5 md:self-stretch" aria-hidden="true"></span>}
                <span class="flex flex-col items-center justify-center">
                  <span class="font-serif text-xl font-semibold text-white sm:text-2xl">{hoved}</span>
                  {under && <span class="mt-1 text-xs font-semibold uppercase tracking-[0.2em] text-sand-300">{under}</span>}
                </span>
              </li>
            );
          })}
        </ul>
      </div>
    )}
  </div>
</section>
