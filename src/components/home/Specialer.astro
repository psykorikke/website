---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../Icon.astro';
import { site } from '../../config/site';
import { specialer } from '../../data/content';

// Photos are picked up automatically from src/assets/images/specialer/<slug>.(jpg|png|webp).
// Until a photo exists, the card shows a tinted panel with the icon instead.
const photos = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/specialer/*.{jpg,jpeg,png,webp}', { eager: true });
const photoFor = (slug: string) =>
  Object.entries(photos).find(([path]) => path.split('/').pop()?.replace(/\.[^.]+$/, '') === slug)?.[1].default;

const tones = ['bg-ice-200', 'bg-sand-200', 'bg-ice-100'];
// Photos: Unsplash licence (free for commercial use).
// brandvaesen – Nejc Soklič, botilbud – Annie Spratt, frivillige – Camylla Battani.
const alts: Record<string, string> = {
  brandvaesen: 'Brandfolk i fuld udrustning med hjelme',
  botilbud: 'To personer laver mad sammen i et hjemligt køkken',
  frivillige: 'En gruppe mennesker samler hænderne i midten',
};
---

<section class="bg-sand-50 py-16 md:py-24" aria-labelledby="specialer-titel">
  <div class="container-site">
    <h2 id="specialer-titel" class="text-center text-2xl sm:text-3xl">Specialiseret i tre områder</h2>

    <div class="mt-12 grid gap-6 sm:grid-cols-3 sm:gap-4 lg:gap-6">
      {specialer.map((s, i) => {
        const photo = photoFor(s.slug);
        return (
          <article class="flex flex-col overflow-hidden bg-white shadow-sm ring-1 ring-sand-200">
            <div class="relative aspect-[4/3]">
              {photo ? (
                <Image
                  src={photo}
                  alt={alts[s.slug] ?? s.title}
                  sizes="(min-width: 1152px) 360px, (min-width: 640px) 33vw, 100vw"
                  class="h-full w-full object-cover"
                />
              ) : (
                <div class={`flex h-full w-full items-center justify-center ${tones[i % tones.length]}`}>
                  <Icon path={s.icon} class="h-16 w-16 text-navy-900/30" />
                </div>
              )}
              <div class="absolute -bottom-6 left-6 flex h-12 w-12 items-center justify-center rounded-full bg-navy-900 text-ice-300 ring-4 ring-white sm:left-4 lg:left-6">
                <Icon path={s.icon} class="h-6 w-6" />
              </div>
            </div>
            <div class="flex flex-1 flex-col p-6 pt-10 sm:p-4 sm:pt-9 lg:p-6 lg:pt-10">
              <h3 class="text-xl break-words hyphens-auto sm:text-base lg:text-xl">{s.title}</h3>
              <p class="mt-3 sm:text-sm lg:text-[15px]">{s.text}</p>
            </div>
          </article>
        );
      })}
    </div>

    {site.kunder.length > 0 && (
      <div class="mt-10 flex flex-col items-center justify-center gap-3 bg-navy-900 px-6 py-6 text-center sm:flex-row sm:gap-5">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-ice-300">Tidligere kunde</p>
        <span class="hidden h-6 w-px bg-white/20 sm:block" aria-hidden="true"></span>
        <p class="text-xl font-semibold tracking-wide text-white sm:text-2xl">{site.kunder.join(' · ')}</p>
      </div>
    )}
  </div>
</section>
