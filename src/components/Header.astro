---
import Logo from './Logo.astro';

// In-page navigation: each link scrolls smoothly to a section on the landing page.
const links = [
  { href: '#workshop', label: 'Workshop' },
  { href: '#samarbejdspartnere', label: 'Tidligere samarbejdspartnere' },
  { href: '#om-mig', label: 'Om mig' },
];
const linkClass =
  'text-xs font-semibold uppercase tracking-[0.15em] text-navy-900 transition-colors hover:text-ice-700 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ice-500';
const kontaktClass = 'btn shrink-0 bg-navy-900 px-5 py-2.5 text-white hover:bg-navy-700';
---

<header class="sticky top-0 z-50 border-b border-ice-200 bg-ice-100">
  <div class="container-site flex h-18 items-center justify-between gap-3">
    <Logo />

    <!-- Desktop: links inline -->
    <nav aria-label="Hovedmenu" class="hidden items-center gap-7 lg:flex">
      {links.map((l) => <a href={l.href} class={`${linkClass} py-2`}>{l.label}</a>)}
      <a href="#kontakt" class={kontaktClass}>Kontakt</a>
    </nav>

    <!-- Phones and tablets: toggle menu (works without JavaScript) -->
    <details id="mobilmenu" class="group lg:hidden">
      <summary
        class="flex h-11 cursor-pointer list-none items-center gap-2 bg-navy-900 px-3 text-xs font-semibold uppercase tracking-[0.1em] text-white hover:bg-navy-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ice-500 [&::-webkit-details-marker]:hidden"
      >
        <svg class="h-5 w-5 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg class="hidden h-5 w-5 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18" />
        </svg>
        Menu
      </summary>
      <nav aria-label="Hovedmenu" class="absolute inset-x-0 top-full border-b border-ice-200 bg-ice-100 shadow-md">
        <ul class="container-site flex flex-col py-2">
          {links.map((l) => (
            <li class="border-b border-ice-200">
              <a href={l.href} class={`${linkClass} block py-4`}>{l.label}</a>
            </li>
          ))}
          <li class="py-4">
            <a href="#kontakt" class={`${kontaktClass} w-full`}>Kontakt</a>
          </li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  // Close the mobile menu after a link is chosen, on Escape, or when tapping outside it.
  const menu = document.getElementById('mobilmenu') as HTMLDetailsElement | null;
  if (menu) {
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => (menu.open = false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
  }
</script>
