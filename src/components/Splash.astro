---
// Subtle decorative "splash": an organic paint blot with a few droplets.
// Purely decorative (aria-hidden). Place inside a `relative overflow-hidden` parent.
interface Props {
  /** Tailwind classes for position, size, colour (text-*) and opacity. */
  class?: string;
  /** Mirror horizontally for variety. */
  flip?: boolean;
  /** Rotation in degrees. */
  rotate?: number;
}
const { class: className = '', flip = false, rotate = 0 } = Astro.props;
const transform = `${flip ? 'scaleX(-1) ' : ''}rotate(${rotate}deg)`;
---

<svg
  class={`pointer-events-none absolute select-none ${className}`}
  style={`transform:${transform}`}
  viewBox="0 0 400 400"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
