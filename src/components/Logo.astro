---
import { Image } from 'astro:assets';
import brainMark from '../assets/brain-mark.png';
import { site, url } from '../config/site';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<!-- For use on navy backgrounds: the mark's own background is navy-900. -->
<a href={url('/')} class={`inline-flex items-center gap-3 ${className}`} aria-label={`${site.name} – forside`}>
  <Image src={brainMark} alt="" width={44} height={44} class="h-11 w-11" loading="eager" />
  <span class="text-lg font-medium uppercase tracking-[0.08em]">
    <span class="text-sand-400">{site.wordmark[0]}</span><span class="text-ice-300">{site.wordmark[1]}</span>
  </span>
</a>
