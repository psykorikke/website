---
// Simple line icon from an SVG path (24x24 grid). Decorative by default.
interface Props {
  path: string;
  class?: string;
}
const { path, class: className = 'h-6 w-6' } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d={path} />
</svg>
