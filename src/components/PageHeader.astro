---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}
const { eyebrow, title, intro } = Astro.props;
---

<section class="bg-sand-100 py-20 md:py-24">
  <div class="container-site max-w-3xl text-center">
    {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
    <h1 class="text-2xl uppercase tracking-[0.06em] break-words hyphens-auto sm:text-4xl sm:tracking-[0.12em]">{title}</h1>
    {intro && <p class="mt-6 text-base sm:text-lg">{intro}</p>}
  </div>
</section>
