---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../config/site';

// The site has no backend, so contact happens by e-mail only (no forms).
const faq = [
  {
    q: 'Hvordan booker jeg en samtale?',
    a: 'Skriv en e-mail med et par ord om, hvad du gerne vil have hjælp til, og hvornår du typisk kan. Så vender vi tilbage med forslag til tidspunkter.',
  },
  {
    q: 'Hvor hurtigt får jeg svar?',
    a: 'Vi bestræber os på at svare inden for to hverdage.',
  },
  {
    q: 'Kan I holde foredrag på vores arbejdsplads?',
    a: 'Ja. Fortæl os om jeres målgruppe, ønsker og mulige datoer, så sender vi et forslag.',
  },
];
---

<Layout title="Kontakt" description="Kontakt Hjernevaerket på e-mail.">
  <PageHeader eyebrow="Kontakt" title="Kontakt" intro="Skriv til os – vi svarer hurtigst muligt." />

  <section class="bg-sand-50 py-20">
    <div class="container-site grid gap-12 md:grid-cols-2">
      <div class="bg-navy-900 p-10 text-sand-200">
        <h2 class="text-xl text-white">Skriv til os</h2>
        <p class="mt-4">Den hurtigste vej til os er en e-mail. Fortæl gerne kort, hvad du ønsker hjælp til.</p>
        <a href={`mailto:${site.email}`} class="btn-primary mt-8">{site.email}</a>
      </div>

      <div id="faq">
        <h2 class="text-xl">Ofte stillede spørgsmål</h2>
        <div class="mt-6 divide-y divide-sand-200 border-y border-sand-200">
          {faq.map((item) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-navy-900 [&::-webkit-details-marker]:hidden">
                {item.q}
                <span class="text-ice-600 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 text-sm">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
