---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../config/site';

// The site has no backend, so contact happens by e-mail only (no forms).
const faq = [
  {
    q: 'Hvordan booker jeg et oplæg eller en workshop?',
    a: 'Send en e-mail med et par ord om jeres arbejdsplads, hvem deltagerne er, og hvad I gerne vil have ud af det. Skriv også gerne, hvornår det kunne passe jer. Så vender Rikke tilbage.',
  },
  {
    q: 'Kan indholdet tilpasses vores arbejdsplads?',
    a: 'Ja. Oplæg og workshops tilrettelægges ud fra jeres hverdag og det, I står i – for eksempel samarbejde på tværs af vagthold, nye kolleger, der skal finde ind, eller roller mellem ledelse og medarbejdere.',
  },
  {
    q: 'Er det for medarbejdere eller ledere?',
    a: 'Begge dele. Rikke arbejder både med kollegagrupper og ledergrupper – og kan også tage fat på samspillet mellem dem.',
  },
  {
    q: 'Arbejder du også med andre brancher?',
    a: 'Specialet er brandvæsen, pædagogiske botilbud og frivillige organisationer. Har I en arbejdsplads med lignende vilkår, er I velkomne til at skrive – så finder vi ud af, om det giver mening.',
  },
];
---

<Layout title="Kontakt" description="Kontakt Hjernevaerket og autoriseret psykolog Rikke Gundorff om oplæg og workshops.">
  <PageHeader eyebrow="Kontakt" title="Kontakt" intro="Skriv til Rikke om oplæg og workshops til jeres arbejdsplads." />

  <section class="bg-sand-50 py-20">
    <div class="container-site grid gap-12 md:grid-cols-2">
      <div class="bg-navy-900 p-6 text-sand-200 sm:p-10">
        <h2 class="text-xl text-white">Skriv til Rikke</h2>
        <p class="mt-4">Den hurtigste vej er en e-mail. Fortæl gerne kort om jeres arbejdsplads, og hvad I gerne vil have ud af et oplæg eller en workshop.</p>
        <a href={`mailto:${site.email}`} class="btn-primary mt-8">Send en e-mail</a>
        <p class="mt-4 text-sm">
          eller skriv direkte til <a href={`mailto:${site.email}`} class="inline-block py-2 font-medium text-ice-300 underline underline-offset-4 [overflow-wrap:anywhere] hover:text-white">{site.email}</a>
        </p>
      </div>

      <div id="faq">
        <h2 class="text-xl">Ofte stillede spørgsmål</h2>
        <div class="mt-6 divide-y divide-sand-200 border-y border-sand-200">
          {faq.map((item) => (
            <details class="group py-3">
              <summary class="flex min-h-11 cursor-pointer py-2 list-none items-center justify-between gap-4 font-semibold text-navy-900 [&::-webkit-details-marker]:hidden">
                {item.q}
                <span class="text-ice-600 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="mt-2 pb-2 text-sm">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
