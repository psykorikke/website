---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { site, url } from '../config/site';
import { specialer } from '../data/content';
---

<Layout title="Om Rikke Gundorff" description={`${site.owner} er autoriseret psykolog og står bag ${site.name}. Hun kender brandvæsen, pædagogiske botilbud og frivillige organisationer indefra.`}>
  <PageHeader eyebrow={site.ownerTitle} title={site.owner} intro={`Psykologen bag ${site.name}`} />

  <section class="bg-sand-50 py-16 md:py-24">
    <div class="container-site grid gap-12 md:grid-cols-[3fr_2fr] md:gap-16">
      <div class="space-y-5 text-base sm:text-lg">
        <p>
          {site.name} er en enkeltmandsvirksomhed drevet af {site.owner}, autoriseret psykolog. Hun holder oplæg og workshops for kollegagrupper og ledergrupper i arbejdspladser, hvor presset er højt, og hvor man er afhængig af hinanden.
        </p>
        <p>
          Rikke arbejder ud fra et socialpsykologisk og evolutionært perspektiv. Hun ser på, hvordan grupper danner territorier, hierarkier og alliancer, hvordan magtkampe opstår – og hvad det betyder for motivationen og samarbejdet.
        </p>
        <p>
          Det særlige er, at hun ikke kun kender arbejdspladserne fra teorien. Hun har selv stået i dem – i uniform, på vagt og i bestyrelseslokalet.
        </p>
        <a href={url('/oplaeg')} class="link-underline">Se oplæg og workshops</a>
      </div>

      <aside>
        <h2 class="text-lg">Erfaring</h2>
        <ul class="mt-6 space-y-4">
          {specialer.map((s) => (
            <li>
              <a href={url(`/specialer/${s.slug}`)} class="group flex gap-4 bg-white p-5 ring-1 ring-sand-200 transition-shadow hover:shadow-md">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-navy-900 text-ice-300"><Icon path={s.icon} class="h-5 w-5" /></span>
                <span>
                  <span class="block font-semibold text-navy-900 group-hover:text-ice-700">{s.title}</span>
                  <span class="mt-1 block text-sm">{s.experience}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <CtaBand />
</Layout>
