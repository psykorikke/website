---
import Layout from '../layouts/Layout.astro';
import { url } from '../config/site';
---

<Layout title="Siden blev ikke fundet">
  <section class="bg-sand-100 py-28">
    <div class="container-site max-w-2xl text-center">
      <p class="eyebrow mb-4">Fejl 404</p>
      <h1 class="text-3xl uppercase tracking-[0.12em] sm:text-4xl">Siden blev ikke fundet</h1>
      <p class="mt-6 text-lg">Beklager, den side du leder efter, findes ikke.</p>
      <a href={url('/')} class="btn-primary mt-10">Gå til forsiden</a>
    </div>
  </section>
</Layout>
