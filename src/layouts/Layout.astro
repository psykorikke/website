---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const siteName = 'Hjernevaerket';
const {
  title,
  description = 'Hjernevaerket',
} = Astro.props;
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta property="og:locale" content="da_DK" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-brand-50 text-brand-900 font-sans antialiased">
    <header class="border-b border-brand-100 bg-white">
      <nav class="mx-auto max-w-5xl px-4 py-4 flex items-center justify-between">
        <a href={`${base}/`} class="text-xl font-semibold tracking-tight text-brand-700">
          {siteName}
        </a>
      </nav>
    </header>

    <main class="flex-1 mx-auto w-full max-w-5xl px-4 py-12">
      <slot />
    </main>

    <footer class="border-t border-brand-100 bg-white">
      <div class="mx-auto max-w-5xl px-4 py-6 text-sm text-brand-500">
        &copy; {new Date().getFullYear()} {siteName}
      </div>
    </footer>
  </body>
</html>
